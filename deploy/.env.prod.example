# Copy to .env.prod and fill in real values.  NEVER commit .env.prod.

# Your domain (point its DNS A record + api/www to the Lightsail static IP)
DOMAIN=yourpos.com

# Postgres (the stack creates this DB inside Docker)
POSTGRES_USER=restrogenic
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=restrogenic

# Secrets — generate with:  openssl rand -hex 32
JWT_SECRET=replace-with-64-char-random-hex
PLATFORM_JWT_SECRET=replace-with-a-DIFFERENT-64-char-random-hex

# CORS — allow your app + all shop subdomains
CORS_ORIGIN=https://*.yourpos.com

# Seed the platform admin + plans on first boot (set false after first run)
SEED_ON_BOOT=true

# ── Razorpay subscription billing (leave blank = MOCK mode, no real charges) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=whsec_set_this_in_razorpay_dashboard
# Map each internal plan id → the Razorpay plan id you create in their dashboard:
RAZORPAY_PLAN_PL_STARTER=
RAZORPAY_PLAN_PL_PRO=
RAZORPAY_PLAN_PL_PREM=
# Webhook URL to register in Razorpay:  https://api.yourpos.com/api/webhooks/razorpay
# Subscribe to events: subscription.activated, subscription.charged,
#                      subscription.halted, subscription.cancelled, payment.failed

# Optional: only if you use the Cloudflare wildcard-TLS Caddy build
# CLOUDFLARE_API_TOKEN=

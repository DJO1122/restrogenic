# ─── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# ─── API (NestJS) ────────────────────────────────────────────────────────────
PORT=3001
JWT_SECRET=change-this-to-a-random-64-char-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# ─── Web (Next.js) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# ─── Restaurant Config ───────────────────────────────────────────────────────
RESTAURANT_NAME=RestroGenie
RESTAURANT_GSTIN=22AAAAA0000A1Z5
RESTAURANT_ADDRESS=123 Main St, City
RESTAURANT_PHONE=+91-9999999999

# ─── AI (Phase 4 - leave blank for now) ─────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Email (for receipts / daily reports) ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
